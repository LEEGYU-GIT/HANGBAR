<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap desktop rescap">
  <Identity Name="Hangbar.Spike" Publisher="CN=HangbarSpike" Version="0.0.1.0" ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>HANGBAR (spike)</DisplayName>
    <PublisherDisplayName>HANGBAR</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Resources>
    <Resource Language="ko-KR" />
  </Resources>
  <Applications>
    <Application Id="Hangbar" Executable="Hangbar.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="HANGBAR" Description="HANGBAR spike" BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <uap:Extension Category="windows.protocol">
          <uap:Protocol Name="hangbar">
            <uap:DisplayName>HANGBAR</uap:DisplayName>
          </uap:Protocol>
        </uap:Extension>
        <desktop:Extension Category="windows.startupTask" Executable="Hangbar.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="HangbarStartup" Enabled="false" DisplayName="HANGBAR" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
